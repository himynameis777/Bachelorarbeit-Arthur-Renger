<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[breed [predators predator]
breed [preys prey]

predators-own [
  pred-hungry
]

preys-own [
  prey-hungry
]

patches-own [
  no-food?
]

globals [
  habitat-loss-applied?
  extinction-tick
  extinct-population

  prey-deaths-predation
  prey-deaths-starvation
  prey-deaths-crowding

  predator-reintroduction-count
  last-predator-reintroduction-tick
]


to setup
  clear-all
  reset-ticks

  set prey-deaths-predation 0
  set prey-deaths-starvation 0
  set prey-deaths-crowding 0

  set predator-reintroduction-count 0
  set last-predator-reintroduction-tick nobody

  set extinction-tick nobody
  set extinct-population "none"

  set habitat-loss-applied? false

  ; color patches in green tones
  ask patches [
    set no-food? false
    set pcolor green + random-normal 0 0.5
  ]

  ; create predators
  create-predators n_preds [
    set shape "wolf"
    set color black
    set size 1
    setxy random-xcor random-ycor
    ; Start all predators with a full hunger budget. Random initial hunger caused
    ; avoidable early deaths before the system could establish baseline dynamics.
    set pred-hungry 0
  ]

  ; create preys
  create-preys n_preys [
    set shape "sheep"
    set color white
    set size 1
    setxy random-xcor random-ycor
    set prey-hungry random max-prey-hungry
  ]
end


to go
  move_pred

  if ticks mod 3 = 0 [
    eatgrass
  ]

  prey-reproduction
  humgry
  move_prey
  crowding-stress
  prey-hunger

  apply-fixed-habitat-loss

  check-extinction

  tick

  if ticks = 3000 [
    stop
  ]
end


to move_pred
  
  ; -------------------------
  ; PREDATOR MOVEMENT
  ; -------------------------
  ask predators [
    let nearby-preys preys in-radius predator-vision
    
    ifelse any? nearby-preys [
      face min-one-of nearby-preys [distance myself]
    ]
    [
      right random 21
      left random 21
    ]
    
    forward 1.2
  ]
end
  
to move_prey
  ; -------------------------
  ; PREY MOVEMENT
  ; -------------------------
  ask preys [
    
    ; CASE 1:
    ; prey is already inside habitat-loss area
    ifelse [no-food?] of patch-here [
      
      ; search only nearby patches, not the whole world
      let escape-patch min-one-of patches in-radius 8 with [not no-food?] [distance myself]
      
      ifelse escape-patch != nobody [
        face escape-patch
        forward 1
      ]
      [
        right random 360
        forward 1
      ]
    ]
    
    ; CASE 2:
    ; prey is on normal habitat
    [
      let nearby-predators predators in-radius prey-vision
      
      ; priority 1: flee predators
      ifelse any? nearby-predators [
        
        let nearest-predator min-one-of nearby-predators [distance myself]
        
        face nearest-predator
        right 180
        
        ifelse [no-food?] of patch-ahead 1 [
          let safe-patch one-of patches in-radius 3 with [not no-food?]
          
          ifelse safe-patch != nobody [
            face safe-patch
            forward 1
          ]
          [
            right random 360
            forward 1
          ]
        ]
        [
          forward 1
        ]
      ]
      
      ; priority 2: herd or move randomly
      [
        ifelse random 100 < herd-chance [
          let nearby-herd other preys in-radius herd-radius
          
          ifelse any? nearby-herd [
            face min-one-of nearby-herd [distance myself]
          ]
          [
            right random 21
            left random 21
          ]
        ]
        [
          right random 21
          left random 21
        ]
        
        ifelse [no-food?] of patch-ahead 1 [
          let safe-patch one-of patches in-radius 3 with [not no-food?]
          
          ifelse safe-patch != nobody [
            face safe-patch
            forward 1
          ]
          [
            right 180
            forward 1
          ]
        ]
        [
          forward 1
        ]
      ]
    ]
  ]
end


to humgry
  ask predators [

    set pred-hungry pred-hungry + 1

    let prey-in-kill-range preys in-radius 1

    if any? prey-in-kill-range [

      let target min-one-of prey-in-kill-range [distance myself]

      ask target [
        set prey-deaths-predation prey-deaths-predation + 1
        die
      ]

      set pred-hungry 0

      if random 100 < predator-reproduction-chance [
        hatch-predators 1 [
          set shape "wolf"
          set color black
          set size 1
          set pred-hungry 0
          right random 360
          forward 1
        ]
      ]
    ]

    if pred-hungry > max-pred-hungry [
      die
    ]
  ]
end

to prey-reproduction
  ask preys [
    if prey-hungry = 0 and not [no-food?] of patch-here [

      ; only reproduce if local prey density is low
      if count other preys in-radius 2 < max-local-prey-density [

        if random 100 < prey-reproduction-chance [
          hatch-preys 1 [
            set shape "sheep"
            set color white
            set size 1
            set prey-hungry random 5
            right random 360
            forward 1
          ]
        ]
      ]
    ]
  ]
end

to eatgrass
  ask patches with [not no-food?] [
    
    ; grass consumption
    if any? preys-here [
      set pcolor pcolor + 0.5
      
      if pcolor >= 59 [
        set pcolor 59
      ]
    ]
    
    ; grass regrowth
    set pcolor pcolor - 0.01
    
    if pcolor <= 52 [
      set pcolor 52
    ]
  ]
end


to prey-hunger
  ask preys [
    
    ifelse [no-food?] of patch-here [
      ; no-food habitat causes strong hunger
      set prey-hungry prey-hungry + 2
    ]
    [
      ; food patch
      ifelse [pcolor] of patch-here >= 58 [
        ; overgrazed grass causes moderate hunger
        set prey-hungry prey-hungry + 1
      ]
      [
        ; good grass reduces hunger
        set prey-hungry prey-hungry - 1
      ]
    ]
    
    if prey-hungry < 0 [
      set prey-hungry 0
    ]
    
    if prey-hungry > max-prey-hungry [
  set prey-deaths-starvation prey-deaths-starvation + 1
  die
]
  ]
end

to crowding-stress
  ask preys [
    let local-density count other preys in-radius 2

    if local-density > max-local-prey-density [
      set prey-hungry prey-hungry + crowding-hunger-cost

      if prey-hungry > max-prey-hungry [
        set prey-deaths-crowding prey-deaths-crowding + 1
        die
      ]
    ]
  ]
end

to apply-fixed-habitat-loss
  if ticks = 2000 and not habitat-loss-applied? [

    ifelse fixed-habitat-loss-percent = 100 [
      ask patches [
        set no-food? true
        set pcolor brown
      ]
    ]
    [
      let target-destroyed round
        (fixed-habitat-loss-percent / 100 * count patches)

      while [count patches with [no-food?] < target-destroyed] [
        let center one-of patches
        let radius min-habitat-loss-radius +
          random (max-habitat-loss-radius - min-habitat-loss-radius + 1)

        ask center [
          ask patches in-radius radius [
            if count patches with [no-food?] < target-destroyed [
              set no-food? true
              set pcolor brown
            ]
          ]
        ]
      ]
    ]

    set habitat-loss-applied? true
  ]
end

to-report habitat-loss-percent
  report 100 * count patches with [no-food?] / count patches
end

to check-extinction
  ; If prey go extinct, the simulation stops.
  ; Without prey, the predator-prey system has collapsed.
  if not any? preys [
    set extinction-tick ticks
    set extinct-population "preys"
    stop
  ]

  ; If predators go extinct, either reintroduce them or stop the simulation.
  if not any? predators [
    ifelse predator-reintroduction? [
      set predator-reintroduction-count predator-reintroduction-count + 1
      set last-predator-reintroduction-tick ticks

      create-predators reintroduced-predators [
        set shape "wolf"
        set color black
        set size 1
        set pred-hungry 0

        ifelse any? patches with [not no-food?] [
          move-to one-of patches with [not no-food?]
        ]
        [
          setxy random-xcor random-ycor
        ]
      ]
    ]
    [
      set extinction-tick ticks
      set extinct-population "predators"
      stop
    ]
  ]
end]]></code>
